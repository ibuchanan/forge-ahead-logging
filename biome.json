{
  "$schema": "https://biomejs.dev/schemas/2.6.2/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "defaultBranch": "main"
  },
  "files": {
    "includes": ["**", "!dist"]
  },
  "formatter": {
    "indentStyle": "space"
  },
  "markdown": {
    "formatter": {
      "enabled": false
    }
  }
}
