{
  "name": "@forge-ahead/logging",
  "version": "0.4.1",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./demo": {
      "import": {
        "types": "./dist/demo.d.mts",
        "default": "./dist/demo.mjs"
      },
      "require": {
        "types": "./dist/demo.d.cts",
        "default": "./dist/demo.cjs"
      }
    },
    "./testing": {
      "import": {
        "types": "./dist/testing.d.mts",
        "default": "./dist/testing.mjs"
      },
      "require": {
        "types": "./dist/testing.d.cts",
        "default": "./dist/testing.cjs"
      }
    }
  },
  "main": "dist/index.cjs",
  "types": "dist/index.d.mts",
  "files": [
    "dist",
    "demo/package.json",
    "testing/package.json"
  ],
  "scripts": {
    "build": "sh scripts/build.sh",
    "changelog": "git cliff --config cliff.toml --unreleased -o CHANGELOG.md",
    "check": "lefthook run pre-push --force",
    "clean": "rm -rf ./node_modules && rm package-lock.json && rm -rf ./dist",
    "dev": "tsdown --watch",
    "format": "biome format --write",
    "format:check": "biome format",
    "lint": "npm exec --yes --package=npm-run-all2@9.0.3 -- npm-run-all --parallel --print-label \"lint:check:*\"",
    "lint:check": "biome lint",
    "lint:fix": "biome lint --write",
    "prepare": "npm run build && (lefthook install || true)",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest watch",
    "typecheck": "tsc --project tsconfig.typecheck.json --noEmit",
    "release:check": "npm test && npm run typecheck && npm run pack:check",
    "todo": "git grep -n -I -F TO\"DO\" -- .; status=$?; if [ \"$status\" -eq 1 ]; then echo \"No TO\"\"DO markers found.\"; elif [ \"$status\" -ne 0 ]; then exit \"$status\"; fi",
    "release": "bash scripts/release.sh",
    "lint:check:biome": "npm run lint:check",
    "lint:check:format": "npm run format:check",
    "pack:check": "npm run build && sh scripts/pack-check.sh",
    "lint:check:typecheck": "npm run typecheck",
    "lint:fallow": "npm exec --yes --package=fallow@3.34.1 -- fallow --fail-on-issues",
    "lint:check:fallow": "npm run lint:fallow",
    "lint:docs": "npm exec --yes --package=markdownlint-cli2@0.24.0 -- markdownlint-cli2 \"**/*.md\" && npm exec --yes --package=cspell@10.4.0 -- cspell lint \"**/*.md\""
  },
  "dependencies": {
    "@forge-ahead/errors": "github:ibuchanan/forge-ahead-errors",
    "pino": "^10.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@types/node": "22",
    "@vitest/coverage-v8": "^5.0",
    "fast-check": "^4.10",
    "lefthook": "^2.2",
    "tsdown": "^0.23",
    "typescript": "^5.9",
    "vitest": "^5.0"
  },
  "engines": {
    "node": ">=22"
  },
  "description": "Structured, bounded, and redacted logging helpers for Forge apps.",
  "author": "ibuchanan"
}
