{
  "name": "@forge-ahead/logging",
  "version": "0.4.1",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./demo": {
      "import": {
        "types": "./dist/demo.d.mts",
        "default": "./dist/demo.mjs"
      },
      "require": {
        "types": "./dist/demo.d.cts",
        "default": "./dist/demo.cjs"
      }
    },
    "./testing": {
      "import": {
        "types": "./dist/testing.d.mts",
        "default": "./dist/testing.mjs"
      },
      "require": {
        "types": "./dist/testing.d.cts",
        "default": "./dist/testing.cjs"
      }
    }
  },
  "main": "dist/index.cjs",
  "types": "dist/index.d.mts",
  "files": [
    "dist",
    "demo/package.json",
    "testing/package.json"
  ],
  "scripts": {
    "build": "tsdown",
    "changelog": "touch CHANGELOG.md && git cliff --offline --unreleased --prepend CHANGELOG.md",
    "check": "lefthook run pre-push --force",
    "clean": "rm -rf ./node_modules && rm package-lock.json && rm -rf ./dist",
    "dev": "tsdown --watch",
    "format": "biome format --write",
    "format:check": "biome format",
    "lint": "lefthook run lint",
    "lint:check": "biome lint",
    "lint:fix": "biome lint --write",
    "prepare": "npm run build && (lefthook install || true)",
    "release:prepare": "scripts/release-prepare.sh",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@forge-ahead/errors": "github:ibuchanan/forge-ahead-errors",
    "pino": "^10.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@types/node": "22",
    "@vitest/coverage-v8": "^5.0",
    "lefthook": "^2.2",
    "tsdown": "^0.23",
    "typescript": "^5.9",
    "vitest": "^5.0"
  },
  "engines": {
    "node": ">=22"
  }
}
